+++ b/crates/cores/snes/src/ppu/sprites.rs
@@ -992,6 +992,108 @@ mod tests {
     use super::*;
     use crate::ppu::Ppu;

+    fn shared_obj_fixture() -> Ppu {
+        let mut ppu = Ppu::new();
+        ppu.line_need_subscreen = true;
+        ppu.line_main_has_obj = true;
+        ppu.line_sub_has_obj = true;
+        ppu.line_main_has_bg = false;
+        ppu.line_sub_has_bg = false;
+        ppu.line_main_enables = 0x10;
+        ppu.line_window_prepared = true;
+        for (i, byte) in ppu.vram.iter_mut().enumerate() {
+            *byte = (i * 17 + 93) as u8;
+        }
+        for (i, color) in ppu.cgram.chunks_exact_mut(2).enumerate() {
+            color.copy_from_slice(&((i as u16 * 117) & 0x7FFF).to_le_bytes());
+        }
+        ppu.rebuild_cgram_rgb_cache();
+        ppu.line_sprites = (0..32)
+            .map(|i| {
+                ppu.build_sprite_data(
+                    i * 7,
+                    0,
+                    i,
+                    (i % 8) as u8,
+                    (i % 4) as u8,
+                    i % 2 == 0,
+                    i % 3 == 0,
+                    SpriteSize::Small,
+                    16,
+                    16,
+                    0,
+                )
+            })
+            .collect();
+        ppu
+    }
+
+    #[test]
+    fn shared_obj_matches_independent_screens_with_windows_and_time_over() {
+        let mut ppu = shared_obj_fixture();
+        let mut visible = 0;
+        for cutoff in [0, 1, 16, 32] {
+            ppu.sprite_time_over = cutoff != 32;
+            ppu.sprite_draw_disabled = cutoff != 32;
+            ppu.sprite_timeover_first_idx = cutoff;
+            for enables in 0..4 {
+                ppu.line_main_has_obj = enables & 1 != 0;
+                ppu.line_sub_has_obj = enables & 2 != 0;
+                for x in 0..256u16 {
+                    ppu.main_obj_window_lut[x as usize] = u8::from(x % 11 < 3);
+                    ppu.sub_obj_window_lut[x as usize] = u8::from(x % 17 < 5);
+                    let main = ppu.render_main_screen_pixel_with_layer_internal(
+                        x,
+                        0,
+                        0x10,
+                        false,
+                        enables & 1 != 0,
+                    );
+                    let sub = ppu.render_sub_screen_pixel_with_layer_internal(
+                        x,
+                        0,
+                        false,
+                        enables & 2 != 0,
+                    );
+                    visible += usize::from(main.0 != 0);
+                    let shared = ppu.shared_sprite_pixel_for_screens(x, 0);
+                    assert_eq!(
+                        ppu.render_main_screen_pixel_with_layer_cached(x, 0, shared),
+                        main
+                    );
+                    assert_eq!(
+                        ppu.render_sub_screen_pixel_with_layer_cached(x, 0, shared),
+                        sub
+                    );
+                }
+            }
+        }
+        assert!(visible > 0);
+    }
+
+    #[test]
+    #[ignore = "manual release benchmark"]
+    fn benchmark_shared_obj_screens() {
+        use std::{hint::black_box, time::Instant};
+        let mut ppu = shared_obj_fixture();
+        for shared in [false, true] {
+            let start = Instant::now();
+            for _ in 0..1000 {
+                for x in 0..256 {
+                    let x = black_box(x);
+                    let cached = if shared {
+                        ppu.shared_sprite_pixel_for_screens(x, 0)
+                    } else {
+                        None
+                    };
+                    black_box(ppu.render_main_screen_pixel_with_layer_cached(x, 0, cached));
+                    black_box(ppu.render_sub_screen_pixel_with_layer_cached(x, 0, cached));
+                }
+            }
+            eprintln!("SNES shared_obj={shared}: {:?}", start.elapsed());
+        }
+    }
+
     fn sprite_test_ppu() -> Ppu {
         let mut ppu = Ppu::new();
         // Tile 0 row 0: leftmost pixel = color 1.
